{
  "name": "physics-trainer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "pt": "node packages/cli/dist/bin.js",
    "check:corpus": "node packages/cli/dist/bin.js check --root fixtures",
    "studio": "pnpm --filter @pt/studio dev",
    "quiz": "pnpm --filter @pt/quiz-app dev",
    "bundle": "node packages/cli/dist/bin.js bundle --out apps/quiz/static/content --strict"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "svelte": "^5.57.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
