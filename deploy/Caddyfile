# Serves the static quiz inside the container. TLS and the public hostname are
# handled by caddy-docker-proxy in front of it (see docker-compose.prod.yml).
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Hashed file names under _app/immutable never change content.
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	# Everything else (pages, content JSON, figures) is revalidated on each load.
	@mutable not path /_app/immutable/*
	header @mutable Cache-Control "no-cache"

	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
