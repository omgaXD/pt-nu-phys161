{
  "name": "@pt/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Authoring & verification tooling (binary: pt).",
  "type": "module",
  "bin": {
    "pt": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "@pt/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@pt/core": "workspace:*",
    "@pt/store-fs": "workspace:*",
    "commander": "^15.0.0",
    "htmlparser2": "^12.0.0",
    "mammoth": "^1.13.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
